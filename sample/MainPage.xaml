<UserControl x:Class="UnRarSample.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1280" Height="720">
  <Grid Background="#FF101820">
    <StackPanel Margin="96,64,96,48">
      <TextBlock Text="Silverlight360.UnRAR" FontSize="48" Foreground="White" />
      <TextBlock Text="RAR archives extracted on the console's hard drive by unrar360.xex" FontSize="22" Foreground="#FF9FC5E8" />
      <TextBlock x:Name="ProgressText" FontSize="20" Foreground="#FF9FC5E8" Margin="0,24,0,0" />
      <TextBlock x:Name="ResultsText" FontSize="18" Foreground="White" Margin="0,16,0,0" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
